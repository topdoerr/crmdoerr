generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Staff {
  staffid     Int      @id @default(autoincrement())
  email       String   @unique
  password    String  
  firstName   String   @map("firstname")
  lastName    String   @map("lastname")
  phonenumber String? 
  active      Int      @default(1)
  admin       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  taskAssignments TaskAssigned[]
  projectMembers  ProjectMember[]

  @@map("tblstaff")
}

model Client {
  id              Int      @id @default(autoincrement())
  company         String  
  vat             String? 
  phonenumber     String? 
  website         String? 
  address         String? 
  city            String? 
  state           String? 
  zip             String? 
  country         Int?     @default(0)
  billingStreet   String?  @map("billing_street")
  billingCity     String?  @map("billing_city")
  billingState    String?  @map("billing_state")
  billingZip      String?  @map("billing_zip")
  billingCountry  Int?     @default(0) @map("billing_country")
  shippingStreet  String?  @map("shipping_street")
  shippingCity    String?  @map("shipping_city")
  shippingState   String?  @map("shipping_state")
  shippingZip     String?  @map("shipping_zip")
  shippingCountry Int?     @default(0) @map("shipping_country")
  active          Int      @default(1)
  datecreated     DateTime @default(now())

  contacts  Contact[]
  invoices  Invoice[]
  projects  Project[]
  contracts Contract[]
  expenses  Expense[]
  leads     Lead[]
  estimates Estimate[]

  @@map("tblclients")
}

model Contact {
  id          Int     @id @default(autoincrement())
  clientId    Int     @map("userid")
  firstName   String  @map("firstname")
  lastName    String  @map("lastname")
  email       String 
  phonenumber String?
  title       String?
  isPrimary   Int     @default(0) @map("is_primary")
  active      Int     @default(1)
  password    String?

  client Client @relation(fields: [clientId], references: [id])

  @@map("tblcontacts")
}

model Invoice {
  id              Int      @id @default(autoincrement())
  clientId        Int      @map("clientid")
  number          Int
  prefix          String? 
  date            DateTime
  dueDate         DateTime @map("duedate")
  subtotal        Decimal  @default(0)
  totalTax        Decimal  @default(0) @map("total_tax")
  discountPercent Decimal  @default(0) @map("discount_percent")
  discountTotal   Decimal  @default(0) @map("discount_total")
  adjustment      Decimal  @default(0)
  total           Decimal  @default(0)
  status          Int      @default(1)
  clientNote      String?  @map("clientnote")
  adminNote       String?  @map("adminnote")
  datecreated     DateTime @default(now())

  client   Client    @relation(fields: [clientId], references: [id])
  payments Payment[]

  @@map("tblinvoices")
}

model Payment {
  id            Int      @id @default(autoincrement())
  invoiceId     Int      @map("invoiceid")
  amount        Decimal 
  date          DateTime
  paymentMode   String?  @map("paymentmode")
  note          String? 
  transactionId String?  @map("transactionid")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("tblpayments")
}

model LineItem {
  id              Int     @id @default(autoincrement())
  relId           Int     @map("rel_id")
  relType         String  @map("rel_type")
  description     String 
  longDescription String? @map("long_description")
  qty             Decimal @default(1)
  rate            Decimal @default(0)
  unit            String?
  itemOrder       Int?    @default(0) @map("item_order")

  @@index([relId, relType])
  @@map("tblitems_in")
}

model Estimate {
  id              Int      @id @default(autoincrement())
  clientId        Int      @map("clientid")
  prefix          String? 
  number          Int
  referenceNo     String?  @map("reference_no")
  date            DateTime
  expirydate      DateTime
  subtotal        Decimal  @default(0)
  totalTax        Decimal  @default(0) @map("total_tax")
  discountPercent Decimal  @default(0) @map("discount_percent")
  discountTotal   Decimal  @default(0) @map("discount_total")
  adjustment      Decimal  @default(0)
  total           Decimal  @default(0)
  status          Int      @default(1)
  datecreated     DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@map("tblestimates")
}

model Proposal {
  id         Int      @id @default(autoincrement())
  subject    String  
  proposalTo String?  @map("proposal_to")
  content    String? 
  date       DateTime
  openTill   DateTime? @map("open_till")
  subtotal   Decimal  @default(0)
  total      Decimal  @default(0)
  status     Int      @default(1)
  datecreated DateTime @default(now())

  @@map("tblproposals")
}

model Contract {
  id            Int      @id @default(autoincrement())
  client        Int      @map("client")
  subject       String  
  description   String? 
  content       String? 
  contractType  Int?     @map("contract_type")
  contractValue Decimal? @map("contract_value")
  datestart     DateTime
  dateend       DateTime?
  signed        Int      @default(0)
  trash         Int      @default(0)
  datecreated   DateTime @default(now())

  contractClient  Client        @relation(fields: [client], references: [id])
  contractTypeRel ContractType? @relation(fields: [contractType], references: [id])

  @@map("tblcontracts")
}

model ContractType {
  id   Int    @id @default(autoincrement())
  name String

  contracts Contract[]

  @@map("tblcontracttypes")
}

model Project {
  id                 Int       @id @default(autoincrement())
  name               String   
  description        String?  
  status             Int       @default(1)
  clientId           Int       @map("clientid")
  billingType        Int       @default(1) @map("billing_type")
  startDate          DateTime  @map("start_date")
  deadline           DateTime?
  projectCost        Decimal?  @default(0) @map("project_cost")
  projectRatePerHour Decimal?  @default(0) @map("project_rate_per_hour")
  estimatedHours     Decimal?  @default(0) @map("estimated_hours")
  progress           Int       @default(0)
  addedfrom          Int?
  dateFinished       DateTime? @map("date_finished")
  projectCreated     DateTime  @default(now()) @map("project_created")

  client  Client          @relation(fields: [clientId], references: [id])
  members ProjectMember[]
  tasks   Task[]
  notes   Note[]

  @@map("tblprojects")
}

model ProjectMember {
  id        Int @id @default(autoincrement())
  projectId Int @map("project_id")
  staffId   Int @map("staff_id")

  project Project @relation(fields: [projectId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [staffid])

  @@unique([projectId, staffId])
  @@map("tblproject_members")
}

model Task {
  id          Int       @id @default(autoincrement())
  name        String   
  description String?  
  priority    Int       @default(0)
  status      Int       @default(1)
  startdate   DateTime?
  duedate     DateTime?
  datefinished DateTime?
  relId       Int?      @map("rel_id")
  relType     String?   @map("rel_type")
  isPublic    Int       @default(0) @map("is_public")
  billable    Int       @default(0)
  kanbanOrder Int       @default(0) @map("kanban_order")
  dateadded   DateTime  @default(now())

  project   Project?       @relation(fields: [relId], references: [id])
  assignees TaskAssigned[]

  @@index([relId, relType])
  @@map("tbltasks")
}

model TaskAssigned {
  id      Int @id @default(autoincrement())
  taskId  Int @map("taskid")
  staffId Int @map("staffid")

  task  Task  @relation(fields: [taskId], references: [id])
  staff Staff @relation(fields: [staffId], references: [staffid])

  @@unique([taskId, staffId])
  @@map("tbltask_assigned")
}

model Lead {
  id            Int       @id @default(autoincrement())
  name          String   
  title         String?  
  company       String?  
  email         String?  
  phonenumber   String?  
  address       String?  
  city          String?  
  state         String?  
  zip           String?  
  country       Int?      @default(0)
  website       String?  
  status        Int       @default(1)
  source        Int?
  assigned      Int?
  leadValue     Decimal?  @map("lead_value")
  dateadded     DateTime  @default(now())
  lost          Int       @default(0)
  junk          Int       @default(0)
  clientId      Int?      @map("clientid")
  dateConverted DateTime? @map("date_converted")

  leadStatus LeadStatus? @relation(fields: [status], references: [id])
  leadSource LeadSource? @relation(fields: [source], references: [id])
  client     Client?     @relation(fields: [clientId], references: [id])

  @@map("tblleads")
}

model LeadStatus {
  id          Int    @id @default(autoincrement())
  name        String
  statusorder Int    @default(0)
  color       String @default("#333")

  leads Lead[]

  @@map("tbllead_status")
}

model LeadSource {
  id   Int    @id @default(autoincrement())
  name String

  leads Lead[]

  @@map("tbllead_sources")
}

model Ticket {
  ticketid Int      @id @default(autoincrement())
  ticketkey String?
  subject  String  
  message  String  
  email    String? 
  name     String? 
  department Int?
  priority Int      @default(0)
  status   Int      @default(1)
  date     DateTime @default(now())
  assigned Int?
  userid   Int?
  contactid Int?
  lastreply DateTime?

  ticketStatus   TicketStatus?   @relation(fields: [status], references: [ticketstatusid])
  ticketPriority TicketPriority? @relation(fields: [priority], references: [id])
  replies        TicketReply[]

  @@map("tbltickets")
}

model TicketReply {
  id       Int      @id @default(autoincrement())
  ticketid Int
  message  String  
  date     DateTime @default(now())
  name     String? 
  email    String? 
  admin    Int?

  ticket Ticket @relation(fields: [ticketid], references: [ticketid])

  @@map("tblticket_replies")
}

model TicketStatus {
  ticketstatusid Int    @id @default(autoincrement())
  name           String
  statusorder    Int    @default(0)
  statuscolor    String @default("#333")

  tickets Ticket[]

  @@map("tblticket_status")
}

model TicketPriority {
  id   Int    @id @default(autoincrement())
  name String

  tickets Ticket[]

  @@map("tblticket_priorities")
}

model Expense {
  id              Int      @id @default(autoincrement())
  expenseName     String   @map("expense_name")
  expenseCategory Int?     @map("category")
  clientId        Int?     @map("clientid")
  amount          Decimal 
  date            DateTime
  billable        Int      @default(0)
  invoiceid       Int?
  datecreated     DateTime @default(now())

  expenseClient      Client?          @relation(fields: [clientId], references: [id])
  expenseCategoryRel ExpenseCategory? @relation(fields: [expenseCategory], references: [id])

  @@map("tblexpenses")
}

model ExpenseCategory {
  id   Int    @id @default(autoincrement())
  name String

  expenses Expense[]

  @@map("tblexpense_categories")
}

model Note {
  id            Int      @id @default(autoincrement())
  relId         Int      @map("rel_id")
  relType       String   @map("rel_type")
  description   String  
  datecontacted DateTime @default(now())
  addedfrom     Int?

  project Project? @relation(fields: [relId], references: [id])

  @@index([relId, relType])
  @@map("tblnotes")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  description String  
  date        DateTime @default(now())
  staffid     Int?

  @@map("tblactivity_log")
}

model TaskTimer {
  id        Int       @id @default(autoincrement())
  taskId    Int       @map("task_id")
  staffId   Int       @map("staff_id")
  startTime DateTime  @map("start_time")
  endTime   DateTime? @map("end_time")
  hourlyRate Decimal? @map("hourly_rate")
  note      String?  

  @@index([taskId])
  @@index([staffId])
  @@map("tbltaskstimers")
}

model FileAttachment {
  id           Int      @id @default(autoincrement())
  relId        Int      @map("rel_id")
  relType      String   @map("rel_type")
  fileName     String   @map("file_name")
  fileType     String?  @map("file_type")
  fileSize     Int?     @map("file_size")
  filePath     String   @map("file_path")
  staffId      Int?     @map("staff_id")
  contactId    Int?     @map("contact_id")
  dateAdded    DateTime @default(now()) @map("date_added")

  @@index([relId, relType])
  @@map("tblfiles")
}

model EmailTemplate {
  id          Int      @id @default(autoincrement())
  name        String  
  slug        String   @unique
  subject     String  
  message     String  
  fromName    String?  @map("from_name")
  fromEmail   String?  @map("from_email")
  plainText   Int      @default(0) @map("plain_text")
  active      Int      @default(1)

  @@map("tblemailtemplates")
}

model EmailQueue {
  id        Int      @id @default(autoincrement())
  toEmail   String   @map("to_email")
  toName    String?  @map("to_name")
  subject   String  
  message   String  
  attempts  Int      @default(0)
  status    String   @default("pending")
  error     String? 
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tblemailqueue")
}

model CalendarEvent {
  id          Int       @id @default(autoincrement())
  title       String   
  description String?  
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  color       String?   @default("#03a9f4")
  isPublic    Int       @default(0) @map("is_public")
  staffId     Int?      @map("staff_id")
  reminderBefore Int?   @map("reminder_before")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([staffId])
  @@index([startDate])
  @@map("tblevents")
}

model KnowledgeBaseArticle {
  id           Int      @id @default(autoincrement())
  subject      String  
  slug         String   @unique
  description  String  
  groupId      Int?     @map("group_id")
  active       Int      @default(1)
  staffArticle Int      @default(0) @map("staff_article")
  views        Int      @default(0)
  datecreated  DateTime @default(now())

  group KnowledgeBaseGroup? @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@map("tblknowledgebase")
}

model KnowledgeBaseGroup {
  id          Int      @id @default(autoincrement())
  name        String  
  description String? 
  groupOrder  Int      @default(0) @map("group_order")
  color       String?  @default("#2a88d5")
  active      Int      @default(1)

  articles KnowledgeBaseArticle[]

  @@map("tblknowledgebase_groups")
}

model CustomField {
  id           Int      @id @default(autoincrement())
  fieldTo      String   @map("field_to")
  name         String  
  slug         String  
  required     Int      @default(0)
  fieldType    String   @map("field_type")
  options      String? 
  displayOrder Int      @default(0) @map("display_order")
  active       Int      @default(1)
  showOnTable  Int      @default(0) @map("show_on_table")
  showOnPdf    Int      @default(0) @map("show_on_pdf")
  onlyAdmin    Int      @default(0) @map("only_admin")

  values CustomFieldValue[]

  @@index([fieldTo])
  @@map("tblcustomfields")
}

model CustomFieldValue {
  id         Int    @id @default(autoincrement())
  fieldId    Int    @map("field_id")
  relId      Int    @map("rel_id")
  fieldTo    String @map("field_to")
  value      String

  field CustomField @relation(fields: [fieldId], references: [id])

  @@index([fieldId, relId, fieldTo])
  @@map("tblcustomfieldsvalues")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String  
  permissions String? 

  @@map("tblroles")
}

model StaffPermission {
  id           Int    @id @default(autoincrement())
  staffId      Int    @map("staff_id")
  feature      String
  capability   String

  @@unique([staffId, feature, capability])
  @@index([staffId])
  @@map("tblstaff_permissions")
}

model RecurringInvoice {
  id             Int       @id @default(autoincrement())
  clientId       Int       @map("clientid")
  subtotal       Decimal   @default(0)
  total          Decimal   @default(0)
  recurringType  String    @map("recurring_type")
  recurringValue Int       @map("recurring_value")
  lastCreated    DateTime? @map("last_created")
  nextCreation   DateTime? @map("next_creation")
  cycles         Int       @default(0)
  totalCycles    Int       @default(0) @map("total_cycles")
  active         Int       @default(1)
  datecreated    DateTime  @default(now())

  @@index([clientId])
  @@map("tblrecurring_invoices")
}

model Subscription {
  id                Int       @id @default(autoincrement())
  name              String   
  description       String?  
  clientId          Int       @map("clientid")
  currency          Int       @default(1)
  price             Decimal  
  tax               Decimal?  @default(0)
  status            String    @default("not_subscribed")
  quantity          Int       @default(1)
  nextBillingCycle  DateTime? @map("next_billing_cycle")
  dateSubscribed    DateTime? @map("date_subscribed")
  dateCanceled      DateTime? @map("date_canceled")
  stripeSubscription String?  @map("stripe_subscription_id")
  datecreated       DateTime  @default(now())

  @@index([clientId])
  @@map("tblsubscriptions")
}

model Announcement {
  id          Int      @id @default(autoincrement())
  name        String  
  message     String  
  showToStaff Int      @default(1) @map("show_to_staff")
  showToClients Int    @default(0) @map("show_to_clients")
  showFrom    Int?     @map("show_from")
  dateStart   DateTime? @map("date_start")
  dateEnd     DateTime? @map("date_end")
  datecreated DateTime @default(now())

  @@map("tblannouncements")
}

model Goal {
  id           Int      @id @default(autoincrement())
  subject      String  
  description  String? 
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  goalType     Int      @map("goal_type")
  contractType Int?     @map("contract_type")
  achievement  String   @default("0")
  notifyWhenAchieved Int @default(1) @map("notify_when_achieved")
  notifyStaff  Int      @default(0) @map("notify_staff")

  @@map("tblgoals")
}

model Survey {
  id               Int      @id @default(autoincrement())
  name             String  
  description      String? 
  fromEmail        String?  @map("from_email")
  fromName         String?  @map("from_name")
  subject          String? 
  emailBody        String?  @map("email_body")
  active           Int      @default(1)
  forStaff         Int      @default(0) @map("for_staff")
  availableToStaff Int      @default(0) @map("available_to_staff")
  createdBy        Int?     @map("created_by")
  datecreated      DateTime @default(now())

  questions SurveyQuestion[]

  @@map("tblsurveys")
}

model SurveyQuestion {
  id           Int     @id @default(autoincrement())
  surveyId     Int     @map("survey_id")
  question     String 
  questionOrder Int    @default(0) @map("question_order")
  questionType String  @map("question_type")
  required     Int     @default(0)

  survey Survey @relation(fields: [surveyId], references: [id])

  @@map("tblsurvey_questions")
}

model Currency {
  id          Int     @id @default(autoincrement())
  name        String 
  symbol      String 
  decimalSeparator String @default(",") @map("decimal_separator")
  thousandSeparator String @default(".") @map("thousand_separator")
  placement   String  @default("before")
  isDefault   Int     @default(0) @map("isdefault")

  @@map("tblcurrencies")
}

model Tax {
  id       Int     @id @default(autoincrement())
  name     String 
  taxRate  Decimal @map("taxrate")

  @@map("tbltaxes")
}

model Department {
  id             Int     @id @default(autoincrement())
  name           String 
  email          String?
  imapUsername   String? @map("imap_username")
  emailPassword  String? @map("email_password")
  calendarId     String? @map("calendar_id")
  hidefromClient Int     @default(0) @map("hidefromclient")

  @@map("tbldepartments")
}

model Setting {
  id    Int    @id @default(autoincrement())
  name  String @unique
  value String

  @@map("tbloptions")
}

// ─── INTRANET MODELS ────────────────────────────────────

model Message {
  id          Int       @id @default(autoincrement())
  fromStaffId Int       @map("from_staff_id")
  toStaffId   Int       @map("to_staff_id")
  subject     String?
  body        String
  read        Int       @default(0)
  parentId    Int?      @map("parent_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([toStaffId, read])
  @@index([fromStaffId])
  @@map("tblmessages")
}

model NewsFeedPost {
  id        Int      @id @default(autoincrement())
  staffId   Int      @map("staff_id")
  content   String
  pinned    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  comments NewsFeedComment[]
  likes    NewsFeedLike[]

  @@index([staffId])
  @@map("tblnewsfeed_posts")
}

model NewsFeedComment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  staffId   Int      @map("staff_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  post NewsFeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("tblnewsfeed_comments")
}

model NewsFeedLike {
  id      Int @id @default(autoincrement())
  postId  Int @map("post_id")
  staffId Int @map("staff_id")

  post NewsFeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, staffId])
  @@map("tblnewsfeed_likes")
}

model PtoPolicy {
  id             Int    @id @default(autoincrement())
  name           String
  daysPerYear    Int    @default(15) @map("days_per_year")
  carryOverMax   Int    @default(5) @map("carry_over_max")
  requireApproval Int   @default(1) @map("require_approval")

  @@map("tblpto_policies")
}

model PtoRequest {
  id          Int       @id @default(autoincrement())
  staffId     Int       @map("staff_id")
  type        String    @default("vacation")
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  days        Float     @default(1)
  reason      String?
  status      String    @default("pending")
  reviewedBy  Int?      @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  reviewNote  String?   @map("review_note")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([staffId])
  @@index([status])
  @@map("tblpto_requests")
}

model PtoBalance {
  id        Int   @id @default(autoincrement())
  staffId   Int   @map("staff_id")
  year      Int
  allocated Float @default(15)
  used      Float @default(0)
  pending   Float @default(0)

  @@unique([staffId, year])
  @@map("tblpto_balances")
}

model DocumentFolder {
  id          Int      @id @default(autoincrement())
  name        String
  parentId    Int?     @map("parent_id")
  createdBy   Int?     @map("created_by")
  isPublic    Int      @default(1) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([parentId])
  @@map("tbldocument_folders")
}

model Document {
  id          Int      @id @default(autoincrement())
  folderId    Int?     @map("folder_id")
  title       String
  description String?
  fileName    String   @map("file_name")
  filePath    String   @map("file_path")
  fileSize    Int?     @map("file_size")
  fileType    String?  @map("file_type")
  version     Int      @default(1)
  uploadedBy  Int?     @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@index([folderId])
  @@map("tbldocuments")
}

model OnboardingTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  items OnboardingItem[]

  @@map("tblonboarding_templates")
}

model OnboardingItem {
  id          Int    @id @default(autoincrement())
  templateId  Int    @map("template_id")
  title       String
  description String?
  itemOrder   Int    @default(0) @map("item_order")
  assignTo    String @default("employee") @map("assign_to")

  template OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("tblonboarding_items")
}

model OnboardingProgress {
  id          Int       @id @default(autoincrement())
  staffId     Int       @map("staff_id")
  templateId  Int       @map("template_id")
  itemId      Int       @map("item_id")
  completed   Int       @default(0)
  completedAt DateTime? @map("completed_at")

  @@unique([staffId, itemId])
  @@index([staffId, templateId])
  @@map("tblonboarding_progress")
}

model CompanyPolicy {
  id              Int      @id @default(autoincrement())
  title           String
  content         String
  version         String   @default("1.0")
  requireAck      Int      @default(1) @map("require_ack")
  publishedAt     DateTime @default(now()) @map("published_at")
  createdAt       DateTime @default(now()) @map("created_at")

  acknowledgements PolicyAcknowledgement[]

  @@map("tblcompany_policies")
}

model PolicyAcknowledgement {
  id        Int      @id @default(autoincrement())
  policyId  Int      @map("policy_id")
  staffId   Int      @map("staff_id")
  ackedAt   DateTime @default(now()) @map("acked_at")

  policy CompanyPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, staffId])
  @@map("tblpolicy_acks")
}

model MeetingRoom {
  id          Int    @id @default(autoincrement())
  name        String
  location    String?
  capacity    Int    @default(10)
  amenities   String?
  color       String @default("#2196f3")
  active      Int    @default(1)

  bookings RoomBooking[]

  @@map("tblmeeting_rooms")
}

model RoomBooking {
  id          Int      @id @default(autoincrement())
  roomId      Int      @map("room_id")
  staffId     Int      @map("staff_id")
  title       String
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  room MeetingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startTime])
  @@index([staffId])
  @@map("tblroom_bookings")
}

model StaffProfile {
  id          Int      @id @default(autoincrement())
  staffId     Int      @unique @map("staff_id")
  birthday    DateTime?
  startDate   DateTime? @map("start_date")
  department  String?
  jobTitle    String?   @map("job_title")
  location    String?
  bio         String?
  phone       String?
  extension   String?
  linkedIn    String?   @map("linkedin")
  reportsTo   Int?      @map("reports_to")

  @@map("tblstaff_profiles")
}

model GoogleCalendarToken {
  id           Int      @id @default(autoincrement())
  staffId      Int      @unique @map("staff_id")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  calendarId   String   @default("primary") @map("calendar_id")
  syncEnabled  Int      @default(1) @map("sync_enabled")
  lastSynced   DateTime? @map("last_synced")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("tblgoogle_calendar_tokens")
}

